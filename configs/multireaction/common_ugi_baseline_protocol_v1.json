{
  "schema_version": "forge.common_ugi_baseline_protocol.v1",
  "benchmark_id": "phase1-common-ugi-generator-benchmark",
  "scientific_question": "Under one component-disjoint Ugi split and one exact verifier, how do vocabulary-free whole-graph generation, reaction-space construction and finite-inventory selection trade exact-L1 yield against open-ended component discovery?",
  "scope": {
